{
	"name": "pdf-to-calendar",
	"private": true,
	"version": "0.1.3",
	"description": "Desktop app to parse timetable PDFs and import events into Notion Calendar databases.",
	"license": "MIT",
	"author": "Samuel F.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/wedsamuel1230/pdf-to-calendar.git"
	},
	"bugs": {
		"url": "https://github.com/wedsamuel1230/pdf-to-calendar/issues"
	},
	"homepage": "https://github.com/wedsamuel1230/pdf-to-calendar",
	"scripts": {
		"dev": "vite dev",
		"dev:web": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tauri-apps/cli": "^2.11.0",
		"@types/node": "^25.6.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"@friendofsvelte/progress": "^0.0.8",
		"@tauri-apps/api": "^2.11.0",
		"lucide-svelte": "^1.0.1",
		"pdfjs-dist": "^5.7.284",
		"zod": "^4.4.2"
	}
}
